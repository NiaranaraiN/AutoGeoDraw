  (setq __water_list (sc_get 'water self_data_list))
  (if (> (length __water_list) 1)
    (sc_emit_poly "water" (mapcar '(lambda (self_pt_list) (sc_xy self_pt_list self_data_list)) __water_list) "Geo_地下水位线" nil nil))
  (if __water_list (sc_emit_text "water:label" (strcat "地下水位" (if (sc_get 'water_note self_data_list)
    (strcat " " (sc_get 'water_note self_data_list)) ""))
    (mapcar '+ (sc_xy (car __water_list) self_data_list) '(0.0 3.0 0.0)) 2.5 0.0 4))
  (sc_frame_model self_data_list) *sc_model*)
