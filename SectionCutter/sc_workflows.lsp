  (if (null (setq __base_list (getpoint "\n恢复成果的基点: "))) (sc_fail "已取消。"))
  (sc_render (sc_put 'base (list (car (trans __base_list 1 0)) (cadr (trans __base_list 1 0)) 0.0) __data_list) nil nil))
