(defun sc_package_import ( / __path_str __lines_list __text_str __value_any __data_list __base_list __existing_list __choice_str __line_str __row_list)
  (setq __path_str (getfiled "导入剖面恢复包" "" "scdata" 0))
  (if (null __path_str) (sc_fail "已取消。"))
  (setq __lines_list (vls_io_read_utf8 __path_str) __text_str "")
  (foreach __line_str __lines_list (setq __text_str (strcat __text_str __line_str)))
  (setq __value_any (vl-catch-all-apply 'read (list __text_str)))
  (if (or (vl-catch-all-error-p __value_any) (not (listp __value_any)) (/= (car __value_any) 'SECTIONCUTTER_PACKAGE) (/= (cadr __value_any) 1)) (sc_fail "不是受支持的恢复包。"))
  (setq __data_list (caddr __value_any)) (sc_validate_package __data_list)
  (foreach __row_list (sc_records) (if (= (sc_get 'id __row_list) (sc_get 'id __data_list)) (setq __existing_list __row_list)))
  (if __existing_list
    (progn
      (initget 1 "Restore Copy Cancel") (setq __choice_str (getkword "\n同编号 [恢复原剖面Restore/另建副本Copy/取消Cancel]: "))
      (cond ((= __choice_str "Cancel") (sc_fail "已取消。"))
        ((= __choice_str "Restore") (sc_guard __existing_list)
          (setq __data_list (sc_put 'roles (sc_get 'roles __existing_list) (sc_put 'members (sc_get 'members __existing_list) __data_list))))
        (T (setq __data_list (sc_put 'id (sc_id) (sc_put 'roles nil (sc_put 'members nil __data_list)))))))
    (setq __data_list (sc_put 'roles nil (sc_put 'members nil __data_list))))
