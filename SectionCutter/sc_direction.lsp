; Visible temporary entities survive native pan/zoom; refresh on view changes.
(defun sc_preview_make (self_dxf_list / __ent_ename)
  (setq __ent_ename (entmakex self_dxf_list))
  (if __ent_ename (setq *sc_preview_entities* (cons __ent_ename *sc_preview_entities*))) __ent_ename)
(defun sc_preview_clear ( / __ent_ename)
  (foreach __ent_ename *sc_preview_entities* (if (entget __ent_ename) (entdel __ent_ename))) (setq *sc_preview_entities* nil))
(defun sc_direction_cleanup ( / )
  (setq *sc_direction_curve* nil)
  (sc_preview_clear))
(defun sc_preview_line (self_a_list self_b_list self_color_int / )
  (sc_preview_make (list '(0 . "LINE") '(8 . "0") (cons 62 self_color_int) '(370 . 70) (cons 10 self_a_list) (cons 11 self_b_list))))
(defun sc_direction_draw ( / __size_real __segs_list __seg_list __points_list __n_int __i_int __p_list __v_list __length_real __unit_list __side_list __a_list __b_list __color_int __text_str __entry_list)
  (sc_preview_clear)
  (setq __size_real (/ (getvar "VIEWSIZE") 35.0) __segs_list (sc_segments *sc_direction_curve*))
  (foreach __seg_list __segs_list
    (setq __n_int (if (= (sc_get 'kind __seg_list) 'line) 1 (max 8 (fix (+ 1 (/ (sc_segment_end __seg_list) (/ pi 36)))))) __i_int 0 __points_list nil)
    (repeat (1+ __n_int)
      (setq __points_list (cons (cons 10 (sc_flat (sc_segment_point __seg_list (* (/ (float __i_int) __n_int) (sc_segment_end __seg_list))))) __points_list) __i_int (1+ __i_int)))
    (sc_preview_make (append (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") '(8 . "0") '(62 . 2) '(100 . "AcDbPolyline")
      (cons 90 (length __points_list)) '(70 . 0) (cons 43 (* 0.12 __size_real))) (reverse __points_list)))
    (setq __p_list (sc_segment_point __seg_list (/ (sc_segment_end __seg_list) 2))
      __v_list (sc_segment_deriv __seg_list (/ (sc_segment_end __seg_list) 2))
      __length_real (distance '(0.0 0.0) (sc_flat __v_list))
      __unit_list (sc_vscale (list (car __v_list) (cadr __v_list) 0.0) (/ __size_real __length_real))
      __side_list (list (- (cadr __unit_list)) (car __unit_list) 0.0)
      __p_list (append (sc_flat __p_list) '(0.0)))
    (sc_preview_line (mapcar '- __p_list __unit_list) (mapcar '+ __p_list __unit_list) 2)
    (sc_preview_make (list '(0 . "SOLID") '(8 . "0") '(62 . 2)
      (cons 10 (mapcar '+ __p_list __unit_list)) (cons 11 (mapcar '+ __p_list (sc_vscale __side_list 0.5)))
      (cons 12 (mapcar '- __p_list (sc_vscale __side_list 0.5))) (cons 13 (mapcar '- __p_list (sc_vscale __side_list 0.5)))))
    (foreach __i_int '(-1 1)
      (sc_preview_line (mapcar '+ __p_list __unit_list) (mapcar '+ __p_list (sc_vscale __side_list (* 0.5 __i_int))) 2)))
  (foreach __entry_list (list (list (sc_segment_point (car __segs_list) 0.0) 3 "起点＝剖面左端")
      (list (sc_segment_point (last __segs_list) (sc_segment_end (last __segs_list))) 1 "终点＝剖面右端"))
    (setq __p_list (append (sc_flat (car __entry_list)) '(0.0)) __color_int (cadr __entry_list) __text_str (caddr __entry_list))
    (sc_preview_make (list '(0 . "CIRCLE") '(8 . "0") (cons 62 __color_int) '(370 . 70) (cons 10 __p_list) (cons 40 (* 0.55 __size_real))))
    (sc_preview_make (list '(0 . "MTEXT") '(100 . "AcDbEntity") '(8 . "0") (cons 62 __color_int) '(100 . "AcDbMText")
      (cons 10 (mapcar '+ __p_list (list __size_real __size_real 0.0))) (cons 40 (* 0.6 __size_real))
      (cons 41 (* 12 __size_real)) '(71 . 1) (cons 1 __text_str)))))
(defun sc_direction_view_command (self_command_str / )
  (command self_command_str)
  (while (/= 0 (logand 1 (getvar "CMDACTIVE"))) (command pause)))
(defun sc_direction_prompt ( / )
  (princ "\n剖切方向：空格或回车确认当前方向 / R反向 / F刷新 / 'ZOOM缩放 / 'PAN平移 / Esc取消 <确认>: "))
(defun sc_direction_choose (self_curve_list / __reverse_bool __choice_str __done_bool __event_list __key_int __view_list __current_list __input_str)
  (setq *sc_direction_curve* self_curve_list)
  (sc_direction_draw)
  (princ "\n绿色起点对应剖面左端，红色终点对应右端，黄色箭头表示展开方向。")
  (princ "\n可用滚轮缩放、中键平移，或透明命令'ZOOM/'PAN查看；此处不用输入DGX图层名。")
  (setq __input_str "" __view_list (list (getvar "VIEWSIZE") (getvar "VIEWCTR") (getvar "SCREENSIZE")))
  (sc_direction_prompt)
  (while (not __done_bool)
    ; Tracking returns control on the next pointer event after native wheel/pan.
    ; Recheck the view instead of relying on command reactors: ZWCAD's wheel
    ; does not send commandEnded or sysVarChanged notifications.
    (setq __event_list (grread T 15 0)
      __current_list (list (getvar "VIEWSIZE") (getvar "VIEWCTR") (getvar "SCREENSIZE")))
    (if (not (equal __view_list __current_list 1e-8))
      (progn (sc_direction_draw) (setq __view_list __current_list)))
    (if (= (car __event_list) 2)
      (progn
        (setq __key_int (cadr __event_list))
        (cond
          ((= __key_int 27) (sc_fail "已取消剖切方向确认。"))
          ((member __key_int '(13 32))
            (setq __choice_str (strcase (vl-string-trim " " __input_str)))
            (cond
              ((= __choice_str "") (setq __done_bool T))
              ((member __choice_str '("R" "REVERSE"))
                (setq __reverse_bool (not __reverse_bool) *sc_direction_curve* (sc_curve_reverse *sc_direction_curve*)) (sc_direction_draw))
              ((member __choice_str '("F" "FRESH")) (sc_direction_draw))
              ((member (vl-string-left-trim "'_ ." __choice_str) '("ZOOM" "PAN"))
                (vl-catch-all-apply 'sc_direction_view_command
                  (list (strcat "_." (vl-string-left-trim "'_ ." __choice_str)))) (sc_direction_draw))
              (T (princ "\n请输入R、F，或按空格或回车确认当前方向。")))
            (setq __input_str "") (if (not __done_bool) (sc_direction_prompt)))
          ((and (= __key_int 8) (> (strlen __input_str) 0))
            (setq __input_str (substr __input_str 1 (1- (strlen __input_str)))) (princ "\010 \010"))
          ((and (>= __key_int 33) (<= __key_int 126) (< (strlen __input_str) 24))
            (setq __input_str (strcat __input_str (chr __key_int))) (princ (chr __key_int)))))))
  (sc_direction_cleanup) (if __reverse_bool "Reverse" "Keep"))
