; Input and reported angles are degrees. Hatch model angles are radians.
(defun sc_pattern_base (self_pattern_str / )
  (if (= (strcase self_pattern_str) "ANSI31") 45.0 0.0))
(defun sc_pattern_angle (self_angle_real / __angle_real)
  (setq __angle_real (sc_angle_positive self_angle_real))
  (if (or (equal __angle_real 0.0 1e-10) (equal __angle_real (* 2.0 pi) 1e-10)) 0.0 __angle_real))
(defun sc_cover_p (self_code_str self_data_list / __style_list)
  (setq __style_list (assoc self_code_str (sc_get 'styles self_data_list)))
  (or (member self_code_str (sc_get 'cover_strata self_data_list))
    (and __style_list (= (nth 6 __style_list) "Cover"))))
(defun sc_projection (self_s_real self_az_real self_dip_real self_data_list / __theta_real __delta_real __cos_real __sin_real __den_real __b_real __plot_real __w_real __vertical_bool)
  (if (or (not (numberp self_az_real)) (not (numberp self_dip_real))
    (< self_az_real 0.0) (>= self_az_real 360.0) (< self_dip_real 0.0) (> self_dip_real 90.0))
    (sc_fail "真实倾向须为0～<360°，真倾角须为0～90°。"))
  (if (or (not (numberp (sc_get 'h self_data_list))) (not (numberp (sc_get 'v self_data_list)))
    (<= (sc_get 'h self_data_list) 0.0) (<= (sc_get 'v self_data_list) 0.0)) (sc_fail "横纵比例必须为正数。"))
  (setq __theta_real (sc_bearing self_s_real self_data_list)
    __delta_real (- (rem (+ (- self_az_real __theta_real) 540.0) 360.0) 180.0)
    __cos_real (cos (* pi (/ __delta_real 180.0))))
  (if (< (abs __cos_real) 1e-10) (setq __cos_real 0.0))
  (setq __w_real (* 180.0 (/ (atan (sqrt (max 0.0 (- 1.0 (* __cos_real __cos_real)))) (abs __cos_real)) pi))
    __vertical_bool (equal self_dip_real 90.0 1e-10))
  (if (and __vertical_bool (= __cos_real 0.0)) (sc_fail "垂直界面与剖切方向平行，投影不唯一，需人工解释。"))
  (setq __sin_real (* (sin (* pi (/ self_dip_real 180.0))) __cos_real)
    __den_real (if __vertical_bool 0.0 (cos (* pi (/ self_dip_real 180.0))))
    __b_real (if (= __sin_real 0.0) 0.0 (* 180.0 (/ (atan __sin_real __den_real) pi)))
    __plot_real (if (= __sin_real 0.0) 0.0
      (- (* 180.0 (/ (atan (* (sc_get 'h self_data_list) __sin_real) (* (sc_get 'v self_data_list) __den_real)) pi)))))
  (list (cons 'station self_s_real) (cons 'az self_az_real) (cons 'dip self_dip_real) (cons 'bearing __theta_real)
    (cons 'delta __delta_real) (cons 'w __w_real) (cons 'apparent __b_real) (cons 'plot __plot_real)
    (cons 'vertical __vertical_bool) (cons 'slope (if (not __vertical_bool) (/ __sin_real __den_real)))
    (cons 'direction (cond ((> __b_real 0.0) "向右下倾") ((< __b_real 0.0) "向左下倾") (T "水平")))))
(defun sc_projection_print (self_label_str self_projection_list / )
  (princ (strcat "\n" self_label_str "：真产状 " (sc_fmt (sc_get 'az self_projection_list)) "°∠" (sc_fmt (sc_get 'dip self_projection_list))
    "°；剖切方位=" (sc_fmt (sc_get 'bearing self_projection_list)) "°；w=" (sc_fmt (sc_get 'w self_projection_list))
    "°；视倾角=" (sc_fmt (abs (sc_get 'apparent self_projection_list))) "°，" (sc_get 'direction self_projection_list)
    "；图上角度=" (sc_fmt (sc_get 'plot self_projection_list)) "°（X正向逆时针为正）。")))
(defun sc_contact_label_point (self_s_real self_z_real self_coeff_list self_data_list self_left_bool / __point_list)
  (if (sc_get 'cover_strata self_data_list)
    (progn
      (setq __point_list (sc_xy (list (+ self_s_real (* (cadr self_coeff_list) 8.0 (sc_get 'v self_data_list))) self_z_real) self_data_list))
      (mapcar '+ __point_list (list (if self_left_bool -3.0 3.0) -8.0 0.0)))
    (mapcar '+ (sc_xy (list self_s_real self_z_real) self_data_list)
      (if self_left_bool '(-3.0 5.0 0.0) '(3.0 10.0 0.0)))))
(defun sc_attitude_report (self_data_list / __row_list __contact_list __key_list __result_any)
  (if (null (sc_get 'contacts self_data_list)) (sc_fail "该剖面没有交点产状数据，请先用SCJG录入。"))
  (princ "\n标注保留真实产状；视倾角用于投影，图上角度已考虑横纵比例。")
  (foreach __row_list (sc_get 'contacts self_data_list)
    (setq __contact_list (cdr __row_list))
    (princ (strcat "\n交点里程=" (sc_fmt (car __row_list)) "m，" (sc_get 'name __contact_list)))
    (foreach __key_list '(("界面自身" az dip) ("前侧地层" la ld) ("后侧地层" ra rd))
      (setq __result_any (vl-catch-all-apply 'sc_projection (list (sc_get 's __contact_list)
        (sc_get (cadr __key_list) __contact_list) (sc_get (caddr __key_list) __contact_list) self_data_list)))
      (if (vl-catch-all-error-p __result_any)
        (progn (princ (strcat "\n" (car __key_list) "：" (if *sc_failure* *sc_failure* (vl-catch-all-error-message __result_any)))) (setq *sc_failure* nil))
        (sc_projection_print (car __key_list) __result_any))))
  (princ))
