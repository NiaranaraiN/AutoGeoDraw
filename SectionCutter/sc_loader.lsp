; Private compatibility loader for legacy toolbox variable names.
; It preserves strings/comments and normalizes self.* and __*.* tokens only.
; Original shared files are never rewritten.
(defun sc_boot_text (self_path_str self_charset_str / __stream_obj __text_str)
  (setq __stream_obj (vlax-create-object "ADODB.Stream"))
  (vlax-put-property __stream_obj 'Type 2) (vlax-put-property __stream_obj 'Charset self_charset_str)
  (vlax-invoke __stream_obj 'Open) (vlax-invoke __stream_obj 'LoadFromFile self_path_str)
  (setq __text_str (vlax-invoke __stream_obj 'ReadText -1))
  (vlax-invoke __stream_obj 'Close) (vlax-release-object __stream_obj) __text_str)
(defun sc_boot_token (self_token_str / )
  (cond
    ((= (strcase self_token_str) "CONSP") "vl-consp")
    ((= (strcase self_token_str) "VLAX-INVOKE-METHOD") "vlax-invoke")
    ((or (wcmatch (strcase self_token_str T) "self.*") (wcmatch self_token_str "__*.*")) (vl-string-translate "." "_" self_token_str))
    (T self_token_str)))
(defun sc_boot_normalize (self_text_str / __i_int __char_str __out_str __token_str __quoted_bool __comment_bool __escape_bool)
  (setq __i_int 1 __out_str "" __token_str "")
  (while (<= __i_int (strlen self_text_str))
    (setq __char_str (substr self_text_str __i_int 1) __i_int (1+ __i_int))
    (cond
      (__comment_bool (setq __out_str (strcat __out_str __char_str)) (if (= __char_str "\n") (setq __comment_bool nil)))
      (__quoted_bool
        (setq __out_str (strcat __out_str __char_str))
        (cond (__escape_bool (setq __escape_bool nil)) ((= __char_str "\\") (setq __escape_bool T)) ((= __char_str "\"") (setq __quoted_bool nil))))
      ((member __char_str '(" " "\t" "\r" "\n" "(" ")" "'" ";" "\""))
        (setq __out_str (strcat __out_str (sc_boot_token __token_str) __char_str) __token_str "")
        (if (= __char_str ";") (setq __comment_bool T))
        (if (= __char_str "\"") (setq __quoted_bool T)))
      (T (setq __token_str (strcat __token_str __char_str)))))
  (strcat __out_str (sc_boot_token __token_str)))
(defun sc_load_toolbox (self_path_str self_name_str / __text_str __cache_str __stream_obj __target_str __result_any __dir_str)
  (setq *sc_toolbox_root* (vl-filename-directory self_path_str)
    __text_str (sc_boot_text self_path_str (if (= self_name_str "TbxlsIO") "utf-8" "gb2312"))
    __text_str (sc_boot_normalize __text_str) __cache_str "D:/var/temp/AICache/AutoGeoDraw")
  (foreach __dir_str '("D:/var" "D:/var/temp" "D:/var/temp/AICache" "D:/var/temp/AICache/AutoGeoDraw")
    (if (not (vl-file-directory-p __dir_str)) (vl-mkdir __dir_str)))
  (setq __target_str (strcat __cache_str "/sc_compat_" self_name_str ".lsp") __stream_obj (vlax-create-object "ADODB.Stream"))
  (vlax-put-property __stream_obj 'Type 2) (vlax-put-property __stream_obj 'Charset "utf-8")
  (vlax-invoke __stream_obj 'Open) (vlax-invoke __stream_obj 'WriteText __text_str)
  (vlax-invoke __stream_obj 'SaveToFile __target_str 2)
  (vlax-invoke __stream_obj 'Close) (vlax-release-object __stream_obj)
  (setq __result_any (vl-catch-all-apply 'load (list __target_str)))
  (if (vl-catch-all-error-p __result_any)
    (progn (princ (strcat "\n通用模块兼容加载失败：" self_name_str " " (vl-catch-all-error-message __result_any))) (exit)))
  __result_any)
