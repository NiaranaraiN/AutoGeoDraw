; Executed in an isolated CAD drawing. Never run in a production drawing.
(defun sc_endpoint_tests ( / __a_ename __b_ename __data_list __result_list __hit_list)
  (sc_layer "DGX")
  (setq __a_ename (sc_make '((0 . "LINE") (8 . "DGX") (10 -10.0 -10.0 90.0) (11 -10.0 10.0 90.0)))
    __b_ename (sc_make '((0 . "LINE") (8 . "DGX") (10 120.0 -10.0 130.0) (11 120.0 10.0 130.0)))
    __data_list '((p . 0.2) (length . 20.0) (plan_points (0.0 0.0 0.0) (100.0 0.0 0.0))))
  (setq __result_list (sc_endpoint_candidate __data_list T '((2.0 110.0) (16.0 110.0))))
  (sc_assert (equal (sc_get 'value __result_list) 100.0 1e-8) "start endpoint bracket interpolation")
  (setq __result_list (sc_endpoint_candidate __data_list nil '((2.0 110.0) (16.0 110.0))))
  (sc_assert (equal (sc_get 'value __result_list) 120.0 1e-8) "end endpoint bracket interpolation")
  (sc_assert (equal (car (sc_get 'outside __result_list)) 24.0 1e-8) "endpoint source station uses actual metres")
  (sc_assert (null (sc_endpoint_candidate __data_list T nil)) "no inside sample requires manual endpoint")
  (sc_assert (null (sc_ray_hits '(0.0 0.0 0.0) '(10.0 0.0 0.0) '((-10.0 1.0 90.0) (-10.0 10.0 90.0)))) "ray rejects extended source segment")
  (sc_assert (null (sc_ray_hits '(0.0 0.0 0.0) '(10.0 0.0 0.0) '((10.0 -1.0 90.0) (10.0 1.0 90.0)))) "ray rejects inward intersections")
  (entdel __a_ename) (entdel __b_ename))
(defun sc_csv_import_tests (self_data_list self_contact_list / __rows_list __text_str __new_list __row_list __bad_list __saved_list)
  (setq __rows_list (sc_csv_rows self_data_list) __text_str "" __saved_list (sc_encode (sc_records)))
  (foreach __row_list __rows_list (setq __text_str (strcat __text_str (sc_csv_line __row_list))))
  (setq __new_list (sc_csv_decode (sc_csv_parse __text_str) self_data_list))
  (sc_assert (equal (sc_get 'controls __new_list) (sc_get 'controls self_data_list) 1e-8) "CSV thickness roundtrip")
  (sc_assert (equal (sc_get 'h __new_list) (sc_get 'h self_data_list) 1e-8) "CSV scale conversion")
  (sc_assert (equal (sc_ci_text (caar (sc_csv_parse (sc_csv_line '("'=literal"))))) "'=literal") "CSV leading apostrophe preserved")
  (setq __bad_list (sc_csv_parse __text_str))
  (setq __rows_list (vl-remove-if '(lambda (self_row_list) (and (= (nth 2 self_row_list) "水位") (equal (distof (nth 3 self_row_list) 2) 50.0 1e-8))) __bad_list))
  (setq __rows_list (append __rows_list (list (list (sc_get 'id self_data_list) (sc_get 'name self_data_list) "水位" "30" "" "" "高程" "102" "m"))))
  (setq __new_list (sc_csv_decode __rows_list self_data_list))
  (sc_assert (and (assoc 30.0 (sc_get 'water __new_list)) (not (assoc 50.0 (sc_get 'water __new_list)))) "CSV add and delete water control")
  (sc_assert (vl-catch-all-error-p (vl-catch-all-apply 'sc_csv_decode
    (list __bad_list (sc_put 'id "wrong-section" self_data_list)))) "CSV wrong section rejected")
  (setq __new_list (sc_csv_decode (sc_csv_parse (sc_boot_text "D:/var/temp/AICache/AutoGeoDraw/SectionCutter_csv_test.csv" "utf-8")) self_data_list))
  (sc_assert (equal (sc_get 'description __new_list) "中文,引号\"测试\"\n第二行") "CSV UTF8 file multiline text readback")
  (setq __text_str "")
  (foreach __row_list (sc_csv_rows self_contact_list) (setq __text_str (strcat __text_str (sc_csv_line __row_list))))
  (setq __new_list (sc_csv_decode (sc_csv_parse __text_str) self_contact_list))
  (sc_assert (equal (sc_get 'la (cdar (sc_get 'contacts __new_list))) 135.0) "CSV contact attitudes")
  (sc_assert (sc_build_model __new_list) "CSV decoded contact model builds")
  (setq __bad_list (sc_csv_parse __text_str))
  (sc_assert (vl-catch-all-error-p (vl-catch-all-apply 'sc_csv_decode (list (append __bad_list (list (cadr __bad_list))) self_contact_list))) "CSV duplicate rejected")
  (sc_assert (vl-catch-all-error-p (vl-catch-all-apply 'sc_csv_decode (list (cons (car __bad_list) (cddr __bad_list)) self_contact_list))) "CSV missing parameter rejected")
  (sc_assert (vl-catch-all-error-p (vl-catch-all-apply 'sc_csv_parse (list "\"unclosed"))) "CSV malformed quotes rejected")
  (sc_assert (vl-catch-all-error-p (vl-catch-all-apply 'sc_ci_number (list "=1+2" 'number))) "CSV formula rejected")
  (sc_assert (equal __saved_list (sc_encode (sc_records))) "CSV validation leaves NOD untouched")
  (setq __rows_list (mapcar '(lambda (self_row_list)
    (if (= (nth 6 self_row_list) "横向比例分母") (subst "200" (nth 7 self_row_list) self_row_list) self_row_list)) (sc_csv_parse __text_str)))
  (setq __new_list (sc_csv_decode __rows_list self_contact_list))
  (sc_assert (equal (sc_get 'h __new_list) 0.2 1e-8) "CSV changed plot scale accepted")
  (setq __new_list (sc_render (sc_put 'manual nil __new_list) T nil))
  (sc_assert (equal (sc_get 'h (car (sc_records))) 0.2 1e-8) "CSV import redraw saved to NOD")
  (sc_assert (not (sc_modified __new_list)) "CSV import geometry agrees with snapshot")
  (setq __rows_list (mapcar '(lambda (self_row_list)
    (if (= (nth 6 self_row_list) "平面比例分母") (subst "200" (nth 7 self_row_list) self_row_list) self_row_list)) __rows_list))
  (sc_assert (vl-catch-all-error-p (vl-catch-all-apply 'sc_csv_decode (list __rows_list self_contact_list))) "CSV changed plan scale rejected")
  (setq *sc_failure* nil))
(defun sc_assert (self_test_bool self_label_str / )
  (if (not self_test_bool) (sc_fail (strcat "TEST FAILED: " self_label_str)))
  (princ (strcat "\nPASS " self_label_str)))
(defun sc_overlay_tests (self_data_list / __model_list __plain_list __record_list __decoded_list __weather_spec_list __roles_list __style_list)
  (setq __style_list '(("Q₄" "ANSI31" 0.5 8 45.0 0.0 "Cover" "砂卵石") ("T₁yn²" "ANSI32" 1.0 9 0.0 0.0 "Rock" "灰岩"))
    self_data_list (sc_put 'styles __style_list (sc_put 'weather '((40.0 1.0 2.0 3.0 4.0) (80.0 2.0 3.0 4.0 5.0)) self_data_list))
    self_data_list (sc_put 'controls (sc_ci_sort (sc_put 80.0 '(0.0 14.0) (sc_get 'controls self_data_list))) self_data_list)
    __model_list (sc_build_model self_data_list)
    __plain_list (sc_build_model (sc_put 'weather nil (sc_put 'contacts nil self_data_list))))
  (sc_assert (equal (vl-remove-if-not '(lambda (self_item_list) (eq (sc_get 'kind self_item_list) 'hatch)) __model_list)
    (vl-remove-if-not '(lambda (self_item_list) (eq (sc_get 'kind self_item_list) 'hatch)) __plain_list)) "contact and weather overlays do not replace thickness hatches")
  (setq __weather_spec_list (vl-remove-if-not '(lambda (self_item_list) (wcmatch (sc_get 'role self_item_list) "weather:*")) __model_list))
  (sc_assert (= (length __weather_spec_list) 4) "four weathering limits are drawn")
  (sc_assert (equal (car (sc_get 'points (car __weather_spec_list))) (sc_xy '(40.0 93.0) self_data_list) 1e-8) "weather depth is measured from bedrock top")
  (sc_assert (vl-some '(lambda (self_item_list) (= (sc_get 'role self_item_list) "contact:0")) __model_list) "contact projection coexists with weather and layers")
  (setq __decoded_list (sc_csv_decode (sc_csv_parse (apply 'strcat (mapcar 'sc_csv_line (sc_csv_rows self_data_list)))) self_data_list))
  (sc_assert (equal (sc_get 'weather __decoded_list) (sc_get 'weather self_data_list) 1e-8) "CSV preserves weather control points")
  (sc_assert (vl-every '(lambda (self_key_sym) (assoc 80.0 (sc_get self_key_sym __decoded_list))) '(controls contacts weather)) "all three control kinds coexist at the same station")
  (sc_assert (= (nth 7 (assoc "Q₄" (sc_get 'styles __decoded_list))) "砂卵石") "CSV preserves material by layer code")
  (sc_assert (not (sc_weather_depths_valid '(2.0 1.0 4.0 5.0))) "descending weather limits rejected")
  (setq self_data_list (sc_render __decoded_list T nil) __roles_list (sc_get 'roles self_data_list)
    __record_list (vl-some '(lambda (self_record_list) (if (= (sc_get 'id self_record_list) (sc_get 'id self_data_list)) self_record_list)) (sc_records)))
  (sc_assert (and (assoc "weather:4" __roles_list) (assoc "cover:base" __roles_list) (assoc "contact:0" __roles_list)
    (equal (sc_get 'weather __record_list) (sc_get 'weather self_data_list))) "DWG stores concurrent overlays and their roles")
  (entdel (sc_alive (cdr (assoc "weather:4" __roles_list))))
  (sc_assert (assoc "weather:4" (sc_get 'roles (sc_render __record_list nil T))) "missing weather line is restored from snapshot"))
(defun sc_smoke ( / __data_list __id_str __roles_list __ent_ename __model_list __name_str __captured_list __count_int __plan_list __hits_list __decoded_list __contacts_list __contact_data_list)
  (test)
  (sc_assert (equal (read (sc_encode T)) T) "boolean survives CAD serialization")
  (setq __decoded_list (read (sc_encode '((x . 1234567.123456789) (text . "T₁yn²") (nothing)))))
  (sc_assert (equal (sc_get 'x __decoded_list) 1234567.123456789 1e-8) "numeric serialization precision")
  (setq __hits_list (sc_intersections '((0.0 0.0 0.0) (100.0 0.0 0.0)) '((50.0 -10.0 200.0) (50.0 10.0 220.0))))
  (sc_assert (and (equal (caar __hits_list) 50.0 1e-8) (equal (cadar __hits_list) 210.0 1e-8)) "XY intersection with elevated source")
  (sc_assert (equal (sc_area (sc_clip '((0 0) (10 0) (10 10) (0 10)) '(1 0 -5))) 50.0 1e-8) "polygon clipping")
  (sc_assert (not (sc_simple '((0 0) (10 10) (0 10) (10 0)) T)) "self-intersecting region rejected")
  (sc_assert (equal (sc_contact_coeff '((s . 50.0) (az . 90.0) (dip . 45.0))
    '((p . 1.0) (plan_points (0.0 0.0 0.0) (100.0 0.0 0.0)) (terrain (0.0 100.0) (100.0 100.0)))) '(1.0 1.0 -150.0) 1e-6) "dip projection independent of plot scale")
  (setq __data_list (sc_demo_at '(1000.0 2000.0 0.0)) __id_str (sc_get 'id __data_list) __count_int (length (sc_get 'members __data_list)))
  (sc_assert (> __count_int 50) "demo creates frame water and geology")
  (sc_assert (= (length (sc_records)) 1) "NOD record saved")
  (setq __data_list (car (sc_records)))
  (sc_assert (not (sc_modified __data_list)) "saved model matches drawing")
  (setq __ent_ename (sc_alive (cdr (assoc "frame:name" (sc_get 'roles __data_list)))))
  (entmod (subst '(1 . "Modified section title") (assoc 1 (entget __ent_ename)) (entget __ent_ename)))
  (sc_assert (sc_modified __data_list) "manual text edit detected")
  (setq __data_list (sc_adopt __data_list))
  (sc_assert (equal (sc_get 'text (car (vl-remove-if-not '(lambda (self_item_list) (= (sc_get 'role self_item_list) "frame:name")) (sc_get 'model __data_list)))) "Modified section title") "adopt stores changed title")
  (sc_assert (equal (sc_get 'text (car (vl-remove-if-not '(lambda (self_item_list) (= (sc_get 'role self_item_list) "frame:name")) (sc_get 'model (car (sc_records)))))) "Modified section title") "adopt persisted to NOD")
  (sc_assert (not (sc_modified __data_list)) "manual edit adopted")
  (setq __ent_ename (sc_alive (cdr (assoc "water" (sc_get 'roles __data_list)))) __name_str (cdr (assoc "frame:name" (sc_get 'roles __data_list))))
  (entdel __ent_ename)
  (setq __data_list (sc_render __data_list nil T))
  (sc_assert (equal (sc_get 'text (car (vl-remove-if-not '(lambda (self_item_list) (= (sc_get 'role self_item_list) "frame:name")) (sc_get 'model __data_list)))) "Modified section title") "repair retains changed title")
  (sc_assert (= __name_str (cdr (assoc "frame:name" (sc_get 'roles __data_list)))) "repair preserves healthy entities")
  (sc_assert (sc_alive (cdr (assoc "water" (sc_get 'roles __data_list)))) "missing water restored")
  (setq __data_list (sc_render __data_list nil nil))
  (sc_assert (= __id_str (sc_get 'id __data_list)) "full redraw preserves section identity")
  (sc_assert (= __count_int (length (sc_get 'members __data_list))) "redraw member count stable")
  (sc_assert (null (sc_alive __name_str)) "old members removed")
  (setq __data_list (car (sc_records)))
  (sc_assert (not (sc_modified __data_list)) "redraw survives NOD roundtrip")
  (sc_assert (equal (sc_get 'text (nth 0 (vl-remove-if-not '(lambda (self_item_list) (= (sc_get 'role self_item_list) "frame:name")) (sc_get 'model __data_list)))) "Modified section title") "adopted title survives redraw")
  (setq __contacts_list '((50.0 (s . 50.0) (name . "Contact1") (kind . "Contact") (left . "T1") (right . "T2") (la . 135.0) (ld . 70.0) (ra . 135.0) (rd . 60.0) (az . 90.0) (dip . 45.0))
    (80.0 (s . 80.0) (name . "F1") (kind . "Fault") (left . "T2") (right . "T3") (la . 135.0) (ld . 60.0) (ra . 135.0) (rd . 50.0) (az . 90.0) (dip . 90.0))))
  (setq __contact_data_list (sc_put 'mode "Contacts" (sc_put 'contacts __contacts_list
    (sc_put 'terrain '((0.0 100.0) (100.0 100.0)) __data_list)))
    __model_list (sc_build_model __contact_data_list))
  (sc_assert (not (vl-some '(lambda (self_item_list) (wcmatch (sc_get 'role self_item_list) "region:contact:*")) __model_list)) "contacts do not generate competing partition hatches")
  (sc_assert (equal (sc_get 'text (car (vl-remove-if-not '(lambda (self_item_list) (= (sc_get 'role self_item_list) "contact:left:0")) __model_list))) "T1 135°∠70°") "side label uses true attitude")
  (sc_assert (= (length (sc_get 'water (sc_remove_point __data_list 'water 50.0))) 2) "remove one water point retains other points")
  (sc_assert (vl-catch-all-error-p (vl-catch-all-apply 'sc_remove_point (list __data_list 'water 51.0))) "reject deleting nonexistent control")
  (sc_assert (vl-catch-all-error-p (vl-catch-all-apply 'sc_remove_point
    (list '((controls (0.0 1.0) (100.0 2.0))) 'controls 0.0))) "retain minimum thickness controls")
  (sc_assert (equal (sc_check __data_list) '(0 0)) "section member health check")
  (sc_assert (equal (sc_csv_cell "a,\"b\"") "\"a,\"\"b\"\"\"") "CSV quotes and commas escaped")
  (sc_assert (equal (sc_csv_cell "=1+1") "\"'=1+1\"") "CSV formula-like text protected")
  (sc_assert (not (vl-some '(lambda (self_row_list) (/= (length self_row_list) 9)) (sc_csv_rows __contact_data_list))) "CSV uniform column count")
  (sc_csv_write (sc_put 'description "中文,引号\"测试\"\n第二行" __contact_data_list) "D:/var/temp/AICache/AutoGeoDraw/SectionCutter_csv_test.csv")
  (sc_csv_import_tests __data_list __contact_data_list)
  (sc_overlay_tests __contact_data_list)
  (sc_endpoint_tests)
  (setq *sc_failure* nil)
  (princ "\nSC_SMOKE_SUCCESS\n") __data_list)
