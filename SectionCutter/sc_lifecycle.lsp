; Private record lifecycle. Never purge the shared VLSGEOCAD root.
(defun sc_record_entries ( / __dict_ename __item_list __out_list __data_any __failure_str __pair_list __key_str)
  (setq __failure_str *sc_failure*)
  (if (setq __dict_ename (sc_store nil))
    (progn
      (foreach __pair_list (entget __dict_ename)
        (if (= (car __pair_list) 3) (setq __key_str (cdr __pair_list)))
        (if (and __key_str (member (car __pair_list) '(350 360))
          (setq __item_list (entget (cdr __pair_list))) (= (cdr (assoc 0 __item_list)) "XRECORD"))
          (progn
            (setq __data_any (vl-catch-all-apply 'sc_read_record (list __item_list)))
            (setq __out_list (cons (list (cons 'key __key_str)
              (cons 'entity (cdr (assoc -1 __item_list))) (cons 'items __item_list)
              (cons 'data (if (not (vl-catch-all-error-p __data_any)) __data_any))) __out_list))))
        (if (member (car __pair_list) '(350 360)) (setq __key_str nil)))))
  (setq *sc_failure* __failure_str) (reverse __out_list))
(defun sc_lifecycle_entities (self_id_str / __ss_set __i_int __ent_ename __out_list)
  (setq __ss_set (ssget "_X" '((-3 ("VLSGEOCAD")))) __i_int 0)
  (if __ss_set
    (repeat (sslength __ss_set)
      (setq __ent_ename (ssname __ss_set __i_int) __i_int (1+ __i_int))
      (if (= self_id_str (sc_get "SectionId" (sc_pairs __ent_ename))) (setq __out_list (cons __ent_ename __out_list)))))
  (reverse __out_list))
(defun sc_lifecycle_role_p (self_role_str / )
  (and (= (type self_role_str) 'STR)
    (wcmatch self_role_str "plan,terrain,water,water:*,frame:*,region:*,strata:*,contact:*,fault:*,feature:*,cover:*")))
(defun sc_lifecycle_writable (self_ent_ename / __layer_list)
  (setq __layer_list (tblsearch "LAYER" (cdr (assoc 8 (entget self_ent_ename)))))
  (if (/= 0 (logand 4 (cdr (assoc 70 __layer_list)))) (sc_fail "待处理对象所在图层已锁定，请解锁后重试。")) T)
(defun sc_detach_section (self_ent_ename self_id_str / __pairs_list)
  (setq __pairs_list (sc_pairs self_ent_ename))
  (if (= (sc_get "SectionId" __pairs_list) self_id_str)
    (progn
      (sc_lifecycle_writable self_ent_ename)
      (setq __pairs_list (vl-remove-if '(lambda (self_pair_list)
        (member (car self_pair_list) '("SectionId" "SectionRole" "JoinedEntityKey"))) __pairs_list) *sc_mutated* T)
      (if (not (vls_xdata_write self_ent_ename "VLSGEOCAD" (vls_xdata_pairs_to_items __pairs_list)))
        (sc_fail "无法解除旧剖面关联。")))) T)
(defun sc_drop_record (self_key_str / __dict_ename __ent_ename)
  (setq __dict_ename (sc_store nil))
  (if (or (null __dict_ename) (null (dictsearch __dict_ename self_key_str))) (sc_fail "剖面记录已改变，请重新选择。"))
  (setq *sc_mutated* T __ent_ename (dictremove __dict_ename self_key_str))
  (if (or (null __ent_ename) (not (entdel __ent_ename))) (sc_fail "无法移除旧剖面记录。")) T)
(defun sc_record_state (self_data_list / __entities_list __live_int __conflict_int __ent_ename __pair_list)
  (setq __entities_list (sc_lifecycle_entities (sc_get 'id self_data_list)) __live_int 0 __conflict_int 0)
  (foreach __ent_ename __entities_list
    (if (/= (sc_get "SectionRole" (sc_pairs __ent_ename)) "plan") (setq __live_int (1+ __live_int))))
  (foreach __pair_list (sc_get 'roles self_data_list)
    (if (setq __ent_ename (sc_alive (cdr __pair_list)))
      (if (or (not (sc_owned __ent_ename self_data_list)) (/= (sc_get "SectionRole" (sc_pairs __ent_ename)) (car __pair_list)))
        (setq __conflict_int (1+ __conflict_int))
        (if (and (/= (car __pair_list) "plan") (not (member __ent_ename __entities_list)))
          (setq __conflict_int (1+ __conflict_int))))))
  (foreach __pair_list (sc_get 'members self_data_list)
    (if (and (setq __ent_ename (sc_alive __pair_list))
      (or (not (sc_owned __ent_ename self_data_list)) (not (member __ent_ename __entities_list))))
      (setq __conflict_int (1+ __conflict_int))))
  (list (cons 'live __live_int) (cons 'conflicts __conflict_int) (cons 'entities __entities_list)))
(defun sc_fresh_id ( / __base_str __id_str __i_int __dict_ename)
  (setq __base_str (sc_id) __id_str __base_str __i_int 0 __dict_ename (sc_store nil))
  (while (and __dict_ename (dictsearch __dict_ename __id_str))
    (setq __i_int (1+ __i_int) __id_str (strcat __base_str "_" (itoa __i_int)))) __id_str)
(defun sc_rebuild_preflight (self_old_list self_plan_ename / __state_list __roles_list __ent_ename __role_str __entry_list __current_list)
  (foreach __entry_list (sc_record_entries)
    (if (= (sc_get 'key __entry_list) (sc_get 'id self_old_list)) (setq __current_list (sc_get 'data __entry_list))))
  (if (not (equal __current_list (sc_put 'version *sc_version* self_old_list) 1e-10)) (sc_fail "旧记录已经改变，请重新进入重建。"))
  (setq __state_list (sc_record_state self_old_list))
  (if (> (sc_get 'conflicts __state_list) 0) (sc_fail "旧成果成员身份冲突，请先用SCREPAIR处理。"))
  (foreach __ent_ename (sc_get 'entities __state_list)
    (setq __role_str (sc_get "SectionRole" (sc_pairs __ent_ename)))
    (if (or (not (sc_lifecycle_role_p __role_str)) (member __role_str __roles_list))
      (sc_fail "旧剖面存在未知或复制的重复成员，请先处理关联。"))
    (setq __roles_list (cons __role_str __roles_list)) (sc_lifecycle_writable __ent_ename))
  (sc_lifecycle_writable self_plan_ename)
  (if (and (sc_get "SectionId" (sc_pairs self_plan_ename))
    (/= (sc_get "SectionId" (sc_pairs self_plan_ename)) (sc_get 'id self_old_list)))
    (sc_fail "所选平面线带有其他剖面关联，请先检查或清理孤立关联。"))
  (foreach __entry_list (sc_records)
    (if (and (/= (sc_get 'id __entry_list) (sc_get 'id self_old_list))
      (= (sc_get 'plan __entry_list) (cdr (assoc 5 (entget self_plan_ename))))) (sc_fail "所选平面线已关联其他剖面。"))) T)
(defun sc_rebuild_commit (self_fresh_list self_old_list self_plan_ename / __entities_list __ent_ename __new_list)
  (if (or (= (sc_get 'id self_fresh_list) (sc_get 'id self_old_list))
    (/= (sc_get 'plan self_fresh_list) (cdr (assoc 5 (entget self_plan_ename))))) (sc_fail "新剖面身份无效。"))
  (sc_rebuild_preflight self_old_list self_plan_ename)
  (setq __entities_list (sc_lifecycle_entities (sc_get 'id self_old_list)))
  ; No old state is inherited. Publish the new model before retiring the old one.
  (setq __new_list (sc_render self_fresh_list T nil))
  (foreach __ent_ename __entities_list
    (if (sc_owned __ent_ename self_old_list)
      (if (= (sc_get "SectionRole" (sc_pairs __ent_ename)) "plan")
        (sc_detach_section __ent_ename (sc_get 'id self_old_list))
        (if (not (entdel __ent_ename)) (sc_fail "旧成果删除失败，本次操作须回退。")))))
  (sc_drop_record (sc_get 'id self_old_list))
  (princ "\n已完全重建地形，旧地质数据及旧成果已移除；可用SCDZTT重新填图。") __new_list)
(defun sc_rebuild (self_old_list / __plan_ename)
  (setq __plan_ename (sc_alive (sc_get 'plan self_old_list)))
  (if (null __plan_ename)
    (setq __plan_ename (car (entsel "\n原平面线已丢失，选择重新剖切的平面线: "))))
  (if (null __plan_ename) (sc_fail "已取消，保留旧数据。"))
  (sc_rebuild_preflight self_old_list __plan_ename)
  (princ (strcat "\n完全重建“" (sc_get 'name self_old_list) "”：重新输入方向、比例及位置；旧岩层、覆盖层、产状、水位、尖灭、描述及人工改线全部放弃。"))
  (if (not (sc_yes "\n新地形成功后移除旧记录及残留成果，继续？")) (sc_fail "已取消，保留旧数据。"))
  (sc_create __plan_ename self_old_list))
(defun sc_clean_candidates ( / __entries_list __keys_list __out_list __entry_list __data_list __state_list __id_str __tagged_list __pair_list __ss_set __i_int __ent_ename __orphans_list __refs_bool)
  (setq __entries_list (sc_record_entries) __keys_list (mapcar '(lambda (self_entry_list) (sc_get 'key self_entry_list)) __entries_list))
  (foreach __entry_list __entries_list
    (setq __data_list (sc_get 'data __entry_list) __id_str (sc_get 'key __entry_list))
    (cond
      ((and __data_list (= (sc_get 'id __data_list) __id_str))
        (setq __state_list (vl-catch-all-apply 'sc_record_state (list __data_list)))
        (if (and (not (vl-catch-all-error-p __state_list)) (= (sc_get 'live __state_list) 0) (= (sc_get 'conflicts __state_list) 0))
          (setq __out_list (cons (list '(kind . "record") (cons 'id __id_str) (cons 'data __data_list)
            (cons 'label (strcat "[成果全失，仍可恢复] " (if (= (type (sc_get 'name __data_list)) 'STR) (sc_get 'name __data_list) __id_str) " | " __id_str))) __out_list))))
      ((and (null __data_list) (wcmatch __id_str "SC_*"))
        (setq __refs_bool nil)
        (foreach __pair_list (sc_get 'items __entry_list)
          (if (and (= (car __pair_list) 331) (entget (cdr __pair_list))) (setq __refs_bool T)))
        (if (and (not __refs_bool) (null (sc_lifecycle_entities __id_str)))
          (setq __out_list (cons (list '(kind . "damaged") (cons 'id __id_str) (cons 'entity (sc_get 'entity __entry_list))
            (cons 'label (strcat "[损坏且无存活引用] " __id_str))) __out_list))))))
  (setq __ss_set (ssget "_X" '((-3 ("VLSGEOCAD")))) __i_int 0)
  (if __ss_set
    (repeat (sslength __ss_set)
      (setq __ent_ename (ssname __ss_set __i_int) __i_int (1+ __i_int) __pair_list (sc_pairs __ent_ename) __id_str (sc_get "SectionId" __pair_list))
      (if (and (= (type __id_str) 'STR) (wcmatch __id_str "SC_*") (not (member __id_str __keys_list))
        (sc_lifecycle_role_p (sc_get "SectionRole" __pair_list)))
        (if (assoc __id_str __orphans_list)
          (setq __orphans_list (subst (cons __id_str (cons (cdr (assoc 5 (entget __ent_ename))) (cdr (assoc __id_str __orphans_list)))) (assoc __id_str __orphans_list) __orphans_list))
          (setq __orphans_list (cons (list __id_str (cdr (assoc 5 (entget __ent_ename)))) __orphans_list))))))
  (foreach __pair_list __orphans_list
    (setq __out_list (cons (list '(kind . "orphan") (cons 'id (car __pair_list)) (cons 'handles (cdr __pair_list))
      (cons 'label (strcat "[仅清孤立关联，保留图形] " (car __pair_list) " | " (itoa (length (cdr __pair_list))) "个对象"))) __out_list)))
  (reverse __out_list))
(defun sc_clean_apply (self_candidates_list / __fresh_list __selected_list __item_list __match_list __candidate_list __ent_ename __id_str __records_int __links_int)
  (setq __fresh_list (sc_clean_candidates) __records_int 0 __links_int 0)
  ; Preflight the entire selection before the first mutation.
  (foreach __item_list self_candidates_list
    (setq __match_list nil)
    (foreach __candidate_list __fresh_list
      (if (and (= (sc_get 'id __candidate_list) (sc_get 'id __item_list)) (= (sc_get 'kind __candidate_list) (sc_get 'kind __item_list))) (setq __match_list __candidate_list)))
    (if (or (null __match_list) (not (equal __item_list __match_list))) (sc_fail "候选数据已改变，请重新扫描后清理。"))
    (if (not (member __match_list __selected_list))
      (progn
        (foreach __ent_ename (sc_lifecycle_entities (sc_get 'id __match_list)) (sc_lifecycle_writable __ent_ename))
        (setq __selected_list (cons __match_list __selected_list)))))
  (foreach __item_list __selected_list
    (setq __id_str (sc_get 'id __item_list))
    (foreach __ent_ename (sc_lifecycle_entities __id_str)
      (if (or (/= (sc_get 'kind __item_list) "orphan") (member (cdr (assoc 5 (entget __ent_ename))) (sc_get 'handles __item_list)))
        (progn (sc_detach_section __ent_ename __id_str) (setq __links_int (1+ __links_int)))))
    (if (/= (sc_get 'kind __item_list) "orphan") (progn (sc_drop_record __id_str) (setq __records_int (1+ __records_int)))))
  (princ (strcat "\n已清理记录" (itoa __records_int) "条、孤立/旧关联" (itoa __links_int) "个；请保存DWG。"))
  (list __records_int __links_int))
(defun sc_clean ( / __candidates_list __selected_list __item_list)
  (setq __candidates_list (sc_clean_candidates))
  (if __candidates_list
    (progn
      (setq __selected_list (sc_clean_choose __candidates_list))
      (foreach __item_list __selected_list (princ (strcat "\n" (sc_get 'label __item_list))))
      (if (not (sc_yes "\n清除所选记录后将失去其恢复依据；孤立关联仅解除、不删图形。确认清理？")) (sc_fail "已取消清理，数据未改变。"))
      (sc_clean_apply __selected_list))
    (princ "\n没有可清理的无用数据；部分缺失或平面线丢失但仍有成果的剖面予以保留。")))
