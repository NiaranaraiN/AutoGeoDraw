; Graphical primitives have a database owner via entmake/entlast.
(defun sc_layer (self_name_str / )
  (or (vls_ensure_layer self_name_str)
    (and (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord") '(100 . "AcDbLayerTableRecord")
      (cons 2 self_name_str) '(70 . 0) '(62 . 7) '(6 . "Continuous"))) (tblsearch "LAYER" self_name_str))))
(defun sc_make (self_dxf_list / __ent_ename)
  (if (not (entmake self_dxf_list)) (sc_fail "创建图元失败。"))
  (setq __ent_ename (entlast) *sc_created* (cons __ent_ename *sc_created*)) __ent_ename)
(defun sc_style ( / )
  (if (not (tblsearch "STYLE" "SC_宋体"))
    (entmake '((0 . "STYLE") (100 . "AcDbSymbolTableRecord") (100 . "AcDbTextStyleTableRecord") (2 . "SC_宋体") (70 . 0) (40 . 0.0) (41 . 0.7) (50 . 0.0) (3 . "simsun.ttf") (4 . "")))))
(defun sc_tag (self_ent_ename self_spec_list self_data_list / __template_str __path_str __pairs_list __kind_str)
  (setq __template_str (cond ((= (sc_get 'role self_spec_list) "terrain") "topographic_profile.vgtpl")
    ((= (sc_get 'role self_spec_list) "plan") "section_line.vgtpl")
    ((= (sc_get 'role self_spec_list) "water") "groundwater_table.vgtpl")
    ((= (sc_get 'layer self_spec_list) "Geo_剖面断层") "fault_line.vgtpl")
    ((= (sc_get 'kind self_spec_list) 'poly) "stratigraphic_boundary.vgtpl")))
  (if __template_str
    (progn
      (setq __path_str (vls_geo_template_path __template_str))
      (if (null __path_str) (setq __path_str (findfile (strcat *sc_toolbox_root* "/vlsgeoconfig/templates/" __template_str))))))
  (if __path_str
    (setq __pairs_list (vls_io_read_template __path_str)))
  (setq __kind_str (strcase (cdr (assoc 0 (entget self_ent_ename))) T))
  (if (member __kind_str '("lwpolyline" "polyline")) (setq __kind_str "polyline"))
  (setq __pairs_list (vl-remove-if '(lambda (self_pair_list) (= (car self_pair_list) "Name")) __pairs_list))
  (setq __pairs_list (sc_put "GeoEntityType" __kind_str (sc_put "GeoEntityKey" (cdr (assoc 5 (entget self_ent_ename)))
    (sc_put "GeoType" (if __template_str (sc_get "GeoType" __pairs_list) (sc_get 'role self_spec_list)) __pairs_list))))
  (setq __pairs_list (sc_put "SectionId" (sc_get 'id self_data_list) (sc_put "SectionRole" (sc_get 'role self_spec_list) __pairs_list)))
  (cond ((= (sc_get 'role self_spec_list) "terrain") (setq __pairs_list (sc_put "JoinedEntityKey" (if (sc_get 'plan self_data_list) (sc_get 'plan self_data_list) "") __pairs_list)))
    ((= (sc_get 'role self_spec_list) "plan") (setq __pairs_list (sc_put "JoinedEntityKey" (cdr (assoc "terrain" (sc_get 'roles self_data_list))) __pairs_list))))
  (if (not (vls_xdata_write self_ent_ename "VLSGEOCAD" (vls_xdata_pairs_to_items __pairs_list)))
    (sc_fail (strcat "图元身份写入失败：" (vl-prin1-to-string __pairs_list)))))
(defun sc_hatch_type (self_pattern_str / __names_list __path_str __file_any __line_str __comma_int __found_bool)
  (if (= self_pattern_str "SOLID") 1
    (progn
      (setq __names_list (if (= (getvar "MEASUREMENT") 1)
        '("acadiso.pat" "zwcadiso.pat" "acadltiso.pat") '("acad.pat" "zwcad.pat" "acadlt.pat"))
        __path_str (vl-some 'findfile __names_list))
      (if (and __path_str (setq __file_any (open __path_str "r")))
        (progn
          (while (and (not __found_bool) (setq __line_str (read-line __file_any)))
            (setq __line_str (vl-string-left-trim " \t" __line_str))
            (if (= (substr __line_str 1 1) "*")
              (progn
                (setq __comma_int (vl-string-search "," __line_str))
                (if __comma_int (setq __line_str (substr __line_str 1 __comma_int)))
                (setq __found_bool (= (strcase (vl-string-trim " \t" (substr __line_str 2))) self_pattern_str)))))
          (close __file_any)))
      (cond (__found_bool 1)
        ((findfile (strcat self_pattern_str ".pat")) 2)
        (T (sc_fail (strcat "未找到填充图案 " self_pattern_str "。请核对地层表，或将同名PAT文件所在目录加入CAD支持文件搜索路径。")))))))
(defun sc_draw_item (self_spec_list self_data_list self_handles_list / __kind_sym __ent_ename __points_list __boundary_ename __obj_obj __array_any __layer_str __pattern_str __pattern_type_int __solid_bool __angle_real __previous_ename __hatch_list)
  (setq __kind_sym (sc_get 'kind self_spec_list) __layer_str (sc_get 'layer self_spec_list))
  (if (not (sc_layer __layer_str)) (sc_fail "图层创建失败。"))
  (if (/= 0 (logand 4 (cdr (assoc 70 (tblsearch "LAYER" __layer_str))))) (sc_fail (strcat "输出图层已锁定：" __layer_str)))
  (cond
    ((= __kind_sym 'poly)
      (setq __points_list (mapcar '(lambda (self_pt_list) (sc_world self_pt_list self_data_list)) (sc_get 'points self_spec_list)))
      (setq __ent_ename (sc_make (append (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") (cons 8 __layer_str)
        (cons 370 (if (= __layer_str "Geo_描述框") 35 18)) '(100 . "AcDbPolyline") (cons 90 (length __points_list))
        (cons 70 (if (sc_get 'closed self_spec_list) 1 0))) (mapcar '(lambda (self_pt_list) (cons 10 (sc_flat self_pt_list))) __points_list)))))
    ((= __kind_sym 'text)
      (setq __ent_ename (sc_make (append (list '(0 . "MTEXT") '(100 . "AcDbEntity") (cons 8 __layer_str) '(100 . "AcDbMText")
        (cons 10 (sc_world (sc_get 'point self_spec_list) self_data_list)) (cons 40 (sc_get 'height self_spec_list))
        (cons 41 (sc_get 'width self_spec_list)) (cons 71 (sc_get 'attach self_spec_list)) (cons 1 (sc_get 'text self_spec_list)))
        (sc_text_props self_spec_list)))))
    ((= __kind_sym 'solid)
      (setq __points_list (mapcar '(lambda (self_pt_list) (sc_world self_pt_list self_data_list)) (sc_get 'points self_spec_list)))
      (setq __ent_ename (sc_make (list '(0 . "SOLID") '(100 . "AcDbEntity") (cons 8 __layer_str) '(100 . "AcDbTrace")
        (cons 10 (nth 0 __points_list)) (cons 11 (nth 1 __points_list)) (cons 12 (nth 2 __points_list)) (cons 13 (nth 3 __points_list))))))
    ((= __kind_sym 'hatch)
      (setq __boundary_ename (sc_alive (cdr (assoc (sc_get 'boundary self_spec_list) self_handles_list))))
      (if (null __boundary_ename) (sc_fail "填充区域边界不存在。"))
      (setq __pattern_str (strcase (sc_get 'pattern self_spec_list)) __pattern_type_int (sc_hatch_type __pattern_str)
        __solid_bool (= __pattern_str "SOLID") __angle_real (cond ((sc_get 'angle self_spec_list)) (T 0.0)))
      (if (vlax-get-acad-object)
        (progn
          (setq __array_any (vlax-make-safearray vlax-vbObject '(0 . 0)))
          (vlax-safearray-put-element __array_any 0 (vlax-ename->vla-object __boundary_ename))
          (setq __obj_obj (vla-AddHatch (vla-get-ModelSpace (vla-get-ActiveDocument (vlax-get-acad-object)))
            __pattern_type_int __pattern_str :vlax-false))
          (vla-AppendOuterLoop __obj_obj (vlax-make-variant __array_any))
          (setq __ent_ename (vlax-vla-object->ename __obj_obj) *sc_created* (cons __ent_ename *sc_created*))
          (vla-put-Layer __obj_obj __layer_str)
          (if (not __solid_bool)
            (progn (vla-put-PatternScale __obj_obj (sc_get 'scale self_spec_list)) (vla-put-PatternAngle __obj_obj __angle_real)))
          (vla-put-Color __obj_obj (sc_get 'color self_spec_list)) (vla-Evaluate __obj_obj))
        (progn
          (setq __previous_ename (entlast))
          (if __solid_bool (command-s "_.-HATCH" "_Properties" __pattern_str "_Select" __boundary_ename "" "")
            (command-s "_.-HATCH" "_Properties" __pattern_str (sc_get 'scale self_spec_list)
              (strcat (rtos (* 180.0 (/ (* (if (= (getvar "ANGDIR") 1) -1.0 1.0) (- __angle_real (getvar "ANGBASE"))) pi)) 2 12) "d")
              "_Select" __boundary_ename "" ""))
          (setq __ent_ename (entlast))
          (if (or (eq __ent_ename __previous_ename) (/= (cdr (assoc 0 (entget __ent_ename))) "HATCH"))
            (sc_fail (strcat "填充生成失败：" __pattern_str)))
          (setq *sc_created* (cons __ent_ename *sc_created*))
          (entmod (append (vl-remove-if '(lambda (self_pair_list) (member (car self_pair_list) '(8 62))) (entget __ent_ename))
            (list (cons 8 __layer_str) (cons 62 (sc_get 'color self_spec_list)))))))
      (setq __hatch_list (entget __ent_ename))
      (if (or (/= (strcase (cdr (assoc 2 __hatch_list))) __pattern_str) (/= (cdr (assoc 76 __hatch_list)) __pattern_type_int))
        (sc_fail (strcat "CAD返回的填充图案或类型与地层表不符：" __pattern_str))))
    (T (sc_fail "未知图元类型。")))
  (sc_tag __ent_ename self_spec_list self_data_list) __ent_ename)
(defun sc_capture (self_ent_ename self_spec_list self_data_list / __dxf_list __points_list __text_str __pair_list)
  (setq __dxf_list (entget self_ent_ename))
  (cond
    ((= (sc_get 'kind self_spec_list) 'poly)
      (if (/= (cdr (assoc 0 __dxf_list)) "LWPOLYLINE") (sc_fail "边界已被替换为不支持的类型。"))
      (foreach __pair_list __dxf_list
        (if (and (= (car __pair_list) 42) (/= (cdr __pair_list) 0.0)) (sc_fail "人工改线暂不接受圆弧段。"))
        (if (= (car __pair_list) 10) (setq __points_list (append __points_list (list (sc_local (append (cdr __pair_list) '(0.0)) self_data_list))))))
      (setq self_spec_list (sc_put 'points __points_list self_spec_list))
      (sc_put 'closed (/= 0 (logand 1 (cdr (assoc 70 __dxf_list)))) self_spec_list))
    ((= (sc_get 'kind self_spec_list) 'text)
      (setq __text_str "")
      (foreach __pair_list __dxf_list (if (member (car __pair_list) '(1 3)) (setq __text_str (strcat __text_str (cdr __pair_list)))))
      (sc_text_capture (sc_put 'attach (cdr (assoc 71 __dxf_list)) (sc_put 'width (cdr (assoc 41 __dxf_list)) (sc_put 'height (cdr (assoc 40 __dxf_list))
        (sc_put 'point (sc_local (cdr (assoc 10 __dxf_list)) self_data_list) (sc_put 'text __text_str self_spec_list))))) __dxf_list))
    ((and (= (sc_get 'kind self_spec_list) 'hatch) (assoc 'angle self_spec_list))
      (if (/= (cdr (assoc 0 __dxf_list)) "HATCH") (sc_fail "填充已被替换为不支持的类型。"))
      (sc_put 'angle (sc_pattern_angle (cond ((cdr (assoc 52 __dxf_list))) (T 0.0))) self_spec_list))
    (T self_spec_list)))
(defun sc_modified (self_data_list / __result_bool __ent_ename __role_str __spec_list)
  (foreach __spec_list (sc_get 'model self_data_list)
    (setq __role_str (sc_get 'role __spec_list))
    (if (and (setq __ent_ename (sc_alive (cdr (assoc __role_str (sc_get 'roles self_data_list))))) (sc_owned __ent_ename self_data_list)
      (not (equal __spec_list (sc_capture __ent_ename __spec_list self_data_list) 1e-6))) (setq __result_bool T))) __result_bool)
(defun sc_guard (self_data_list / )
  (if (sc_modified self_data_list) (sc_fail "发现未采纳的改线或文字。先用SCADOPT采纳，或用SCRESTORE明确放弃后恢复。")))
(defun sc_render (self_data_list self_rebuild_bool self_missing_bool / __model_list __old_list __roles_list __ent_ename __role_str __saved_list __plan_ename __pair_list __spec_list)
  (if self_rebuild_bool (setq __model_list (sc_build_model self_data_list)) (setq __model_list (sc_get 'model self_data_list)))
  (if (null __model_list) (sc_fail "没有可重绘的成果。"))
  (setq *sc_mutated* T __old_list (sc_get 'roles self_data_list) *sc_created* nil)
  (foreach __spec_list __model_list
    (setq __role_str (sc_get 'role __spec_list) __ent_ename nil)
    (if self_missing_bool
      (progn (setq __ent_ename (sc_alive (cdr (assoc __role_str __old_list))))
        (if (and __ent_ename (not (sc_owned __ent_ename self_data_list))) (sc_fail "对象身份冲突，不能自动接管。"))))
    (if (null __ent_ename) (setq __ent_ename (sc_draw_item __spec_list self_data_list __roles_list)))
    (setq __roles_list (append __roles_list (list (cons __role_str (cdr (assoc 5 (entget __ent_ename))))))))
  (setq self_data_list (sc_put 'model __model_list (sc_put 'roles __roles_list (sc_put 'members (mapcar 'cdr __roles_list) self_data_list))))
  (if (setq __plan_ename (sc_alive (sc_get 'plan self_data_list)))
    (sc_tag __plan_ename '((kind . poly) (role . "plan") (layer . "平面剖切线")) self_data_list))
  (sc_text_front self_data_list)
  (sc_save self_data_list)
  (foreach __pair_list __old_list
    (if (and (not (member (cdr __pair_list) (sc_get 'members self_data_list))) (setq __ent_ename (sc_alive (cdr __pair_list))) (sc_owned __ent_ename self_data_list))
      (if (not (entdel __ent_ename)) (sc_fail "无法删除旧成果，执行UNDO回退本操作后检查锁定图层。"))))
  (setq *sc_created* nil)
  (princ "\n成果已写入NOD，请保存DWG。") self_data_list)
(defun sc_frame_refresh (self_data_list / __old_frame_list __keep_model_list __keep_roles_list __spec_list __role_str __ent_ename __new_roles_list __new_model_list __pair_list)
  (foreach __spec_list (sc_get 'model self_data_list)
    (setq __role_str (sc_get 'role __spec_list))
    (if (wcmatch __role_str "frame:*")
      (progn
        (setq __ent_ename (sc_alive (cdr (assoc __role_str (sc_get 'roles self_data_list)))))
        (if __ent_ename
          (progn
            (if (not (sc_owned __ent_ename self_data_list)) (sc_fail "图框成员身份冲突，请先修复关联。"))
            (if (not (equal __spec_list (sc_capture __ent_ename __spec_list self_data_list) 1e-6)) (sc_fail "图框有未采纳修改，请先用SCADOPT采纳后再更新图框。"))))
        (setq __old_frame_list (cons (cdr (assoc __role_str (sc_get 'roles self_data_list))) __old_frame_list)))
      (progn (setq __keep_model_list (append __keep_model_list (list __spec_list)))
        (if (assoc __role_str (sc_get 'roles self_data_list)) (setq __keep_roles_list (cons (assoc __role_str (sc_get 'roles self_data_list)) __keep_roles_list))))))
  (setq *sc_model* nil) (sc_frame_model self_data_list) (setq __new_model_list *sc_model* *sc_mutated* T)
  (foreach __spec_list __new_model_list
    (setq __ent_ename (sc_draw_item __spec_list self_data_list __new_roles_list)
      __new_roles_list (cons (cons (sc_get 'role __spec_list) (cdr (assoc 5 (entget __ent_ename)))) __new_roles_list)))
  (setq __new_roles_list (append __keep_roles_list __new_roles_list)
    self_data_list (sc_put 'model (append __keep_model_list __new_model_list)
      (sc_put 'roles __new_roles_list (sc_put 'members (mapcar 'cdr __new_roles_list) self_data_list))))
  (sc_save self_data_list)
  (foreach __role_str __old_frame_list
    (if (setq __ent_ename (sc_alive __role_str))
      (if (not (entdel __ent_ename)) (sc_fail "旧图框无法删除，请检查锁定图层。"))))
  (princ "\n描述框已更新，地质图形保持原位。请保存DWG。") self_data_list)
(defun sc_adopt (self_data_list / __model_list __ent_ename __new_list __terrain_list __points_list __last_real __pt_list __spec_list)
  (foreach __spec_list (sc_get 'model self_data_list)
    (setq __ent_ename (sc_alive (cdr (assoc (sc_get 'role __spec_list) (sc_get 'roles self_data_list)))))
    (if (or (null __ent_ename) (not (sc_owned __ent_ename self_data_list))) (sc_fail "成员缺失或身份冲突，请先恢复或修复关联。"))
    (setq __new_list (sc_capture __ent_ename __spec_list self_data_list))
    (if (and (= (sc_get 'kind __new_list) 'poly) (sc_get 'closed __new_list) (< (sc_area (sc_get 'points __new_list)) 1e-7)) (sc_fail "闭合区域面积为零。"))
    (if (and (= (sc_get 'kind __new_list) 'poly) (sc_get 'closed __new_list) (not (sc_simple (sc_get 'points __new_list) T))) (sc_fail "闭合区域自相交，不能采纳。"))
    (if (= (sc_get 'role __new_list) "terrain")
      (progn
        (setq __terrain_list (mapcar '(lambda (self_pt_list) (sc_actual self_pt_list self_data_list)) (sc_get 'points __new_list)))
        (foreach __pt_list __terrain_list
          (if (and __last_real (<= (car __pt_list) __last_real)) (sc_fail "地形线必须沿里程严格递增。"))
          (setq __last_real (car __pt_list)))))
    (if (wcmatch (sc_get 'role __new_list) "frame:description:*")
      (setq self_data_list (sc_put (read (substr (sc_get 'role __new_list) 19)) (sc_get 'text __new_list) self_data_list)))
    (setq __model_list (append __model_list (list __new_list))))
  (sc_save (sc_put 'manual T (sc_put 'terrain __terrain_list (sc_put 'model __model_list self_data_list)))))
