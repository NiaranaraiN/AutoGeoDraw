; Styles extracted from the user's DWT into the portable project DXF template.
(setq *sc_text_style_records* nil)
(defun sc_text_style_record (self_pairs_list / __base_list __apps_list __app_str __items_list __pair_list)
  (foreach __pair_list self_pairs_list
    (cond
      ((= (car __pair_list) 1001)
        (if __app_str (setq __apps_list (append __apps_list (list (cons __app_str __items_list)))))
        (setq __app_str (cdr __pair_list) __items_list nil))
      (__app_str (setq __items_list (append __items_list (list __pair_list))))
      ((member (car __pair_list) '(0 100 2 3 4 70 71 40 41 42 50)) (setq __base_list (append __base_list (list __pair_list))))))
  (if __app_str (setq __apps_list (append __apps_list (list (cons __app_str __items_list)))))
  (append __base_list (if __apps_list (list (cons -3 __apps_list)))))
(defun sc_text_template ( / __path_str __lines_list __code_int __value_any __record_list __records_list)
  (if (null *sc_text_style_records*)
    (progn
      (setq __path_str (strcat (vl-filename-directory *sc_root*) "/ProgramTemplate/SectionCutterTextStyles.dxf"))
      (if (not (findfile __path_str)) (sc_fail "缺少ProgramTemplate/SectionCutterTextStyles.dxf文字样式模板。"))
      (setq __lines_list (vls_io_read_utf8 __path_str))
      (while (cdr __lines_list)
        (setq __code_int (atoi (car __lines_list)) __value_any (cadr __lines_list) __lines_list (cddr __lines_list))
        (if (= __code_int 0)
          (progn
            (if (and (= (cdr (assoc 0 __record_list)) "STYLE")
              (member (cdr (assoc 2 __record_list)) '("宋体3.5" "宋体5.0")))
              (setq __records_list (cons (cons (cdr (assoc 2 __record_list)) (sc_text_style_record __record_list)) __records_list)))
            (setq __record_list nil)))
        (setq __value_any (cond ((member __code_int '(40 41 42 50)) (atof __value_any))
          ((member __code_int '(70 71 1070 1071)) (atoi __value_any)) (T __value_any)))
        (setq __record_list (append __record_list (list (cons __code_int __value_any)))))
      (if (or (null (assoc "宋体3.5" __records_list)) (null (assoc "宋体5.0" __records_list)))
        (sc_fail "文字样式模板缺少宋体3.5或宋体5.0。"))
      (setq *sc_text_style_records* __records_list))) *sc_text_style_records*)
(defun sc_text_style_name (self_height_real / )
  (cond ((equal self_height_real 3.5 1e-8) "宋体3.5") ((equal self_height_real 5.0 1e-8) "宋体5.0") (T "SC_宋体")))
(defun sc_text_ensure_style (self_name_str / __record_list __app_list)
  (if (not (tblsearch "STYLE" self_name_str))
    (if (= self_name_str "SC_宋体") (sc_style)
      (progn
        (setq __record_list (cdr (assoc self_name_str (sc_text_template))))
        (if (null __record_list) (sc_fail (strcat "文字样式不存在：" self_name_str)))
        (setq *sc_mutated* T)
        (foreach __app_list (cdr (assoc -3 __record_list)) (regapp (car __app_list)))
        (if (not (entmake __record_list)) (sc_fail (strcat "无法从模板导入文字样式：" self_name_str)))))) self_name_str)
(defun sc_text_defaults (self_spec_list / __name_str)
  (setq __name_str (sc_text_style_name (sc_get 'height self_spec_list)))
  (if (and (= __name_str "SC_宋体") (sc_get 'style self_spec_list)) (setq __name_str (sc_get 'style self_spec_list)))
  (setq self_spec_list (sc_put 'style __name_str self_spec_list))
  (if (wcmatch (sc_get 'role self_spec_list) "contact:left:*,contact:right:*")
    (setq self_spec_list (sc_put 'text_flags 19 (sc_put 'mask_scale 1.3 (sc_put 'mask_color 7 self_spec_list))))) self_spec_list)
(defun sc_text_props (self_spec_list / __out_list)
  (setq __out_list (list (cons 7 (sc_text_ensure_style (if (sc_get 'style self_spec_list) (sc_get 'style self_spec_list) "SC_宋体")))))
  (if (assoc 'text_flags self_spec_list)
    (setq __out_list (append __out_list (list (cons 90 (sc_get 'text_flags self_spec_list))
      (cons 45 (sc_get 'mask_scale self_spec_list)) (cons 63 (sc_get 'mask_color self_spec_list)))))) __out_list)
(defun sc_text_capture (self_spec_list self_dxf_list / )
  (if (assoc 'style self_spec_list) (setq self_spec_list (sc_put 'style (cdr (assoc 7 self_dxf_list)) self_spec_list)))
  (if (assoc 'text_flags self_spec_list)
    (setq self_spec_list (sc_put 'text_flags (if (assoc 90 self_dxf_list) (cdr (assoc 90 self_dxf_list)) 0)
      (sc_put 'mask_scale (if (assoc 45 self_dxf_list) (cdr (assoc 45 self_dxf_list)) 1.5)
        (sc_put 'mask_color (if (assoc 63 self_dxf_list) (cdr (assoc 63 self_dxf_list)) 7) self_spec_list))))) self_spec_list)
(defun sc_text_front (self_data_list / __ss_set __spec_list __ent_ename)
  (setq __ss_set (ssadd))
  (foreach __spec_list (sc_get 'model self_data_list)
    (if (and (= (sc_get 'kind __spec_list) 'text) (sc_get 'text_flags __spec_list)
      (/= 0 (logand 1 (sc_get 'text_flags __spec_list)))
      (setq __ent_ename (sc_alive (cdr (assoc (sc_get 'role __spec_list) (sc_get 'roles self_data_list)))))
      (sc_owned __ent_ename self_data_list)) (ssadd __ent_ename __ss_set)))
  (if (> (sslength __ss_set) 0) (command-s "_.DRAWORDER" __ss_set "" "_Front")))
(defun sc_text_refresh (self_data_list / __model_list __spec_list __ent_ename __dxf_list __props_list __remove_list)
  (sc_guard self_data_list)
  ; Check all affected entities before importing styles or changing text.
  (foreach __spec_list (sc_get 'model self_data_list)
    (if (and (= (sc_get 'kind __spec_list) 'text)
      (setq __ent_ename (sc_alive (cdr (assoc (sc_get 'role __spec_list) (sc_get 'roles self_data_list))))))
      (progn
        (if (not (sc_owned __ent_ename self_data_list)) (sc_fail "文字成员身份冲突，请先修复关联。"))
        (sc_lifecycle_writable __ent_ename))))
  (foreach __spec_list (sc_get 'model self_data_list)
    (if (= (sc_get 'kind __spec_list) 'text)
      (progn
        (setq __spec_list (sc_text_defaults __spec_list) __props_list (sc_text_props __spec_list))
        (if (setq __ent_ename (sc_alive (cdr (assoc (sc_get 'role __spec_list) (sc_get 'roles self_data_list)))))
          (progn
            (setq __dxf_list (entget __ent_ename) __remove_list (if (assoc 'text_flags __spec_list) '(7 90 45 63 421 441) '(7)) *sc_mutated* T)
            (if (not (entmod (append (vl-remove-if '(lambda (self_pair_list) (member (car self_pair_list) __remove_list)) __dxf_list) __props_list)))
              (sc_fail "文字格式更新失败，须回退。"))
            (entupd __ent_ename)))))
    (setq __model_list (append __model_list (list __spec_list))))
  (setq self_data_list (sc_put 'model __model_list self_data_list))
  (sc_text_front self_data_list) (sc_save self_data_list)
  (princ "\n文字格式已更新：产状标注加框、背景遮罩1.3；内容、位置及地质成员保持。请保存DWG。") self_data_list)
