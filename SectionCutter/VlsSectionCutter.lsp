(defun sc_description_edit (self_data_list / __values_list)
  (setq __values_list (sc_form "描述栏（无内容填-；\\P可换行）"
    (mapcar '(lambda (self_key_sym self_label_str) (list self_label_str (if (sc_get self_key_sym self_data_list) (sc_get self_key_sym self_data_list) "-") 'text))
      '(direction location description) '("方位" "位置" "工程地质条件评价"))))
  (mapcar '(lambda (self_key_sym self_value_str) (setq self_data_list (sc_put self_key_sym self_value_str self_data_list)))
    '(direction location description) __values_list) self_data_list)
(defun sc_style_edit (self_data_list / __values_list __code_str __styles_list __old_list)
  (setq __values_list (sc_form "岩性填充样式（有亚层时输入代号/亚层编号）"
    '(("完整地层编号" "T1" text) ("CAD填充图案名" "ANSI31" text) ("图案比例" "1" positive) ("颜色索引1～255" "8" positive)
      ("图案原始基准角(度)" "45" number) ("额外旋转角(度)" "0" number) ("类型：岩层/覆盖层" "岩层" text))))
  (if (> (nth 3 __values_list) 255) (sc_fail "颜色须为1～255。"))
  (if (or (> (abs (nth 4 __values_list)) 360.0) (> (abs (nth 5 __values_list)) 360.0)) (sc_fail "图案角度须在-360～360°之间。"))
  (if (not (member (nth 6 __values_list) '("岩层" "覆盖层" "Rock" "Cover"))) (sc_fail "地层类型须为岩层或覆盖层（Rock/Cover）。"))
  (setq __styles_list (sc_get 'styles self_data_list) __code_str (car __values_list) __old_list (assoc __code_str __styles_list))
  (if (assoc __code_str __styles_list) (setq __styles_list (vl-remove (assoc __code_str __styles_list) __styles_list)))
  (sc_put 'styles (cons (cons __code_str (append (list (nth 1 __values_list) (nth 2 __values_list) (fix (nth 3 __values_list))
    (nth 4 __values_list) (nth 5 __values_list) (if (member (nth 6 __values_list) '("覆盖层" "Cover")) "Cover" "Rock")
    (if __old_list (nth 7 __old_list)))
    (if (and __old_list (nth 9 __old_list)) (list (nth 8 __old_list) (nth 9 __old_list))))) __styles_list) self_data_list))
(defun sc_update (self_data_list / __ent_ename __points_list __data_list)
  (sc_guard self_data_list)
  (if (not (sc_yes "\n重新读取地形并重算成果，已采纳人工线形将被替换，继续？")) (sc_fail "保留原成果。"))
  (setq __ent_ename (sc_alive (sc_get 'plan self_data_list)))
  (if (null __ent_ename) (sc_fail "平面线丢失，请先重新关联。"))
  (if (not (sc_curve_matches __ent_ename self_data_list)) (sc_fail "平面线形已改变；须新建剖面，避免旧控制点里程错位。"))
  (setq __data_list (sc_extract self_data_list))
  (sc_render (sc_put 'manual nil __data_list) T nil))
(defun sc_demo_at (self_base_list / __data_list)
  (setq __data_list (list (cons 'id (sc_id)) '(name . "示例剖面（合成数据）") '(p . 1.0) '(h . 0.5) '(v . 0.5)
    '(datum . 80.0) '(station . 0.0) '(step . 10.0) '(vstep . 10.0) '(length . 100.0) (cons 'base self_base_list)
    '(plan_points (0.0 0.0 0.0) (100.0 0.0 0.0))
    '(terrain (0.0 105.0) (20.0 108.0) (40.0 114.0) (60.0 112.0) (80.0 106.0) (100.0 103.0))
    '(strata "Q₄" "T₁yn²")
    '(controls (0.0 4.0 10.0) (40.0 6.0 12.0) (70.0 0.0 15.0) (100.0 0.0 12.0))
    '(water (10.0 100.0) (50.0 103.0) (90.0 99.0)) '(water_note . "示例观测")
    '(direction . "起点→终点") '(location . "示例场地") '(description . "合成资料，仅用于检查版式。\\P上部土层向右尖灭。")
    '(styles ("Q₄" "ANSI31" 0.5 8) ("T₁yn²" "ANSI32" 1.0 9))))
  (sc_render __data_list T nil))

(defun test ( / __data_list)
  (if (not (equal (sc_interp 5.0 '((0.0 10.0) (10.0 20.0))) 15.0 1e-8)) (sc_fail "插值测试失败。"))
  (setq __data_list '((h . 0.2) (v . 0.5) (datum . 100.0)))
  (if (not (equal (sc_xy '(10.0 104.0) __data_list) '(50.0 8.0 0.0) 1e-8)) (sc_fail "比例测试失败。"))
  (princ "\n基础计算测试通过。"))
(defun start_program (self_mode_str / __data_list __point_list __choice_str __old_p_real)
  (cond
    ((member self_mode_str '("SCDZTT" "SCMANAGE"))
      (setq __data_list (sc_select) self_mode_str (sc_menu __data_list)))
    ((= self_mode_str "SCDZPM")
      (setq __data_list (sc_new))
      ; The completed terrain phase is an independent recovery checkpoint.
      (vla-EndUndoMark *sc_document*) (vla-StartUndoMark *sc_document*) (setq *sc_mutated* nil)
      (setq self_mode_str (sc_menu __data_list))))
  (cond
    ((= self_mode_str "SCDXPM") (sc_new))
    ((= self_mode_str "SCSCPM")
      (initget "New Existing") (setq __choice_str (getkword "\n目标剖面 [新建New/已有地形Existing]<New>: "))
      (setq __data_list (if (= __choice_str "Existing") (sc_select) (sc_new)))
      (vla-EndUndoMark *sc_document*) (vla-StartUndoMark *sc_document*) (setq *sc_mutated* nil)
      (sc_cross __data_list))
    ((= self_mode_str "SCDEMO")
      (if (setq __point_list (getpoint "\n示例剖面基点: ")) (sc_demo_at (list (car (trans __point_list 1 0)) (cadr (trans __point_list 1 0)) 0.0)) (sc_fail "已取消。")))
    ((= self_mode_str "SCLAYERS") (sc_project_edit __data_list) (princ "\n已保存项目信息表和地层表。"))
    ((= self_mode_str "SCIMPORT") (sc_package_import))
    ((= self_mode_str "SCCLEAN") (sc_clean))
    (T
      (if (null __data_list) (setq __data_list (sc_select)))
      (cond
        ((= self_mode_str "SCCHECK") (sc_check __data_list))
        ((= self_mode_str "SCAPPDIP") (sc_attitude_report __data_list))
        ((= self_mode_str "SCTEXT") (sc_text_refresh __data_list))
        ((= self_mode_str "SCFRAME") (sc_frame_refresh __data_list))
        ((= self_mode_str "SCREBUILD") (sc_rebuild __data_list))
        ((= self_mode_str "SCCSV") (sc_csv_export __data_list))
        ((= self_mode_str "SCCSVIMPORT") (sc_csv_import __data_list))
        ((= self_mode_str "SCDRAW") (sc_guard __data_list) (sc_render __data_list nil nil))
        ((= self_mode_str "SCRESTORE") (sc_restore __data_list))
        ((= self_mode_str "SCREPAIR") (sc_repair __data_list))
        ((= self_mode_str "SCRELINK") (sc_relink __data_list))
        ((= self_mode_str "SCADOPT") (sc_adopt __data_list))
        ((= self_mode_str "SCEXPORT") (sc_package_export __data_list))
        ((= self_mode_str "SCMOVE") (sc_move __data_list))
        ((= self_mode_str "SCUPDATE") (sc_update __data_list))
        (T
          (sc_guard __data_list)
          (setq __old_p_real (sc_get 'p __data_list))
          (setq __data_list
            (cond ((= self_mode_str "SCDELETEPOINT") (sc_point_delete __data_list))
              ((= self_mode_str "SCEDIT") (sc_control_edit __data_list))
              ((= self_mode_str "SCJG") (sc_contact_edit __data_list))
              ((= self_mode_str "SCWATER") (sc_water_edit __data_list))
              ((= self_mode_str "SCPINCH") (sc_pinch_edit __data_list))
              ((= self_mode_str "SCDESC") (sc_description_edit __data_list))
              ((= self_mode_str "SCSTYLE") (sc_style_edit __data_list))
              ((= self_mode_str "SCCOVER") (sc_cover_edit __data_list))
              ((= self_mode_str "SCSET") (sc_settings __data_list))
              (T (sc_fail "未知操作。"))))
          (if (not (equal __old_p_real (sc_get 'p __data_list) 1e-10))
            (sc_fail "已有剖面不能直接改变平面比例；请按正确比例新建，以免控制点里程错位。"))
          (sc_edit_commit __data_list))))))
(defun sc_cleanup ( / )
  (setq *sc_clean_choice* nil *sc_clean_all* nil)
  (sc_curve_cleanup)
  (sc_direction_cleanup)
  (if *sc_dialog* (progn (unload_dialog *sc_dialog*) (setq *sc_dialog* nil)))
  (if *sc_stream* (progn (vl-catch-all-apply 'vlax-invoke-method (list *sc_stream* 'Close)) (vlax-release-object *sc_stream*) (setq *sc_stream* nil))))
(defun sc_run (self_mode_str / *error* __result_any __old_cmdecho_int __old_osmode_int __old_dimzin_int)
  (defun *error* (self_message_str /)
    (sc_cleanup)
    (if __old_cmdecho_int (setvar "CMDECHO" __old_cmdecho_int))
    (if __old_osmode_int (setvar "OSMODE" __old_osmode_int))
    (if __old_dimzin_int (setvar "DIMZIN" __old_dimzin_int))
    (if *sc_document* (vl-catch-all-apply 'vla-EndUndoMark (list *sc_document*)))
    (princ (strcat "\nSectionCutter：" (if *sc_failure* *sc_failure* self_message_str))) (princ))
  (setq *sc_failure* nil *sc_created* nil *sc_mutated* nil)
  (if (= (getvar "CVPORT") 1) (sc_fail "请切换到模型空间操作。"))
  (setq *sc_document* (vla-get-ActiveDocument (vlax-get-acad-object))
    __old_cmdecho_int (getvar "CMDECHO") __old_osmode_int (getvar "OSMODE") __old_dimzin_int (getvar "DIMZIN"))
  (setvar "CMDECHO" 0) (setvar "DIMZIN" 0)
  (vla-StartUndoMark *sc_document*)
  (setq __result_any (vl-catch-all-apply 'start_program (list self_mode_str)))
  (sc_cleanup) (vla-EndUndoMark *sc_document*)
  (if (vl-catch-all-error-p __result_any)
    (progn
      (if *sc_mutated* (command-s "_.U"))
      (princ (strcat "\nSectionCutter：" (if *sc_failure* *sc_failure* (vl-catch-all-error-message __result_any)))))
    (vla-Regen *sc_document* 1))
  (setvar "CMDECHO" __old_cmdecho_int) (setvar "OSMODE" __old_osmode_int) (setvar "DIMZIN" __old_dimzin_int)
  (setq *sc_created* nil *sc_mutated* nil) (princ))
