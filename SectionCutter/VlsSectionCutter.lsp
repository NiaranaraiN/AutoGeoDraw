(foreach __sc_file_str '("sc_core" "sc_ui" "sc_contact" "sc_model" "sc_render" "sc_workflows" "sc_csv_import" "sc_curve" "sc_direction" "sc_attitude" "sc_cover" "sc_lifecycle" "sc_text") (load (strcat *sc_root* "/" __sc_file_str ".lsp")))
