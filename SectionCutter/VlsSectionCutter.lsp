  (setq __sc_found_str nil)
  (foreach __sc_folder_str '("" "W:/OneXA/AutoCadSupports/vlsToolbox/" "W:/Ondrive_XA/AutoCadSupports/vlsToolbox/"
    "D:/OnedriveLS/OneDrive/Work/OneXA/AutoCadSupports/vlsToolbox/")
    (if (and (null __sc_found_str) (findfile (strcat __sc_folder_str __sc_module_str ".lsp")))
      (setq __sc_found_str (findfile (strcat __sc_folder_str __sc_module_str ".lsp")))))
  (if __sc_found_str (sc_load_toolbox __sc_found_str __sc_module_str)
