      "D:/OnedriveLS/OneDrive/Work/Code/LISP/AutoGeoDraw/SectionCutter/VlsSectionCutter.lsp")
      (if (and (null *sc_root*) (findfile __sc_path_str)) (setq *sc_root* (vl-filename-directory (findfile __sc_path_str)))))))
